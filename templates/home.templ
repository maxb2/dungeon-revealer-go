package templates

templ Home() {
	@Layout("Player") {
		<main class="player-view" hx-ext="sse" sse-connect="/events?role=player">
			<header class="topbar">
				<h1>Dungeon Revealer</h1>
				<nav>
					<a href="/logout">Logout</a>
				</nav>
			</header>
			<div class="content player-layout">
				<div class="map-area" hx-get="/maps/active" hx-trigger="load" hx-target="this">
					<p class="muted">Waiting for the DM to select a map...</p>
				</div>
				<aside class="sidebar">
					@ChatPanel()
					<section class="sidebar-section">
						@NotesPanel(false)
					</section>
					<div id="notes-content"></div>
				</aside>
			</div>
			<div id="sse-chat" sse-swap="chatMessage" hx-target="#chat-messages" hx-swap="beforeend"></div>
			<div hx-trigger="sse:fogUpdate" style="display:none"></div>
			<div hx-trigger="sse:tokenUpdate" style="display:none"></div>
			<script>
				document.body.addEventListener('sse:fogUpdate', function(e) {
					var view = document.getElementById('player-map-view');
					var currentMapId = view ? view.dataset.mapId : '';
					var pushedMapId = e.detail && e.detail.data ? e.detail.data : '';
					if (!currentMapId || (pushedMapId && pushedMapId !== currentMapId)) {
						var mapArea = document.querySelector('.map-area');
						if (mapArea) htmx.ajax('GET', '/maps/active', {target: mapArea, swap: 'innerHTML'});
					}
				});
			</script>
		</main>
	}
}
