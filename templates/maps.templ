package templates

import (
	"fmt"
	"github.com/matt/dungeon-revealer-go/internal/store"
)

templ MapList(maps []*store.Map, activeID string) {
	<div id="map-list" hx-swap-oob="true">
		<form
			hx-post="/dm/maps/upload"
			hx-target="#map-list"
			hx-encoding="multipart/form-data"
			class="upload-form"
		>
			<input type="file" name="map" accept="image/*" required/>
			<input type="text" name="title" placeholder="Map title (optional)"/>
			<button type="submit">Upload</button>
		</form>
		if len(maps) == 0 {
			<p class="muted">No maps uploaded yet.</p>
		} else {
			<ul class="map-items">
				for _, m := range maps {
					<li class={ "map-item", templ.KV("active", m.ID == activeID) }>
						<button
							hx-post={ fmt.Sprintf("/dm/maps/%s/activate", m.ID) }
							hx-target="#map-list"
							class="map-select-btn"
						>
							{ m.Title }
						</button>
						<button
							hx-delete={ fmt.Sprintf("/dm/maps/%s", m.ID) }
							hx-target="#map-list"
							hx-confirm="Delete this map?"
							class="map-delete-btn"
						>
							&times;
						</button>
					</li>
				}
			</ul>
		}
	</div>
}

templ MapAreaEmpty() {
	<div id="dm-map-view">
		<p class="muted">Select or upload a map to get started.</p>
	</div>
}

templ MapAreaImage(m *store.Map) {
	<div id="dm-map-view" class="canvas-container" data-map-id={ m.ID }>
		<div class="fog-toolbar">
			<button data-dm-mode="fog" class="active">Fog</button>
			<button data-dm-mode="tokens">Tokens</button>
			<button data-dm-mode="walls">Walls</button>
			<span class="toolbar-sep"></span>
			<span class="fog-tools">
				<button data-fog-tool="reveal" class="active">Reveal</button>
				<button data-fog-tool="shroud">Shroud</button>
				<span class="toolbar-sep"></span>
				<button data-fog-shape="brush" class="active">Brush</button>
				<button data-fog-shape="rect">Rectangle</button>
				<span class="toolbar-sep"></span>
				<label>Size <input type="range" data-fog-brush-size min="5" max="200" value="40"/></label>
			</span>
			<span class="token-tools" style="display:none">
				<label>Name <input type="text" data-token-label placeholder="unnamed" class="token-input-text"/></label>
				<label>Color <input type="color" data-token-color value="#e94560"/></label>
				<label>Size <input type="range" data-token-radius min="5" max="300" value="20"/></label>
				<label><input type="checkbox" data-token-visible/> Visible</label>
				<label><input type="checkbox" data-token-moveable checked/> Moveable</label>
			</span>
			<span class="wall-tools" style="display:none">
				<span class="toolbar-hint">Click to add vertices. Click first vertex or double-click to close. Esc to cancel. Click a wall to delete.</span>
			</span>
			<span class="toolbar-sep"></span>
			<button data-fog-push class="push-btn">Push to Players</button>
			<button data-fog-clear>Reset (Hide All)</button>
			<button data-fog-reveal-all>Reveal All</button>
			<span class="toolbar-sep"></span>
			<label class="toolbar-label">
				if m.DynamicLighting {
					<input type="checkbox" data-toggle-dynamic-lighting checked/> Dynamic Lighting
				} else {
					<input type="checkbox" data-toggle-dynamic-lighting/> Dynamic Lighting
				}
			</label>
		</div>
		<div class="canvas-wrap">
			<div class="zoom-wrap">
				<img src={ fmt.Sprintf("/dm/maps/%s/image", m.ID) } alt={ m.Title } class="map-image"/>
			</div>
		</div>
		<script>
			(function() {
				var container = document.getElementById('dm-map-view');
				DungeonRevealer.initDMCanvas(container, container.dataset.mapId);
			})();
		</script>
	</div>
}

templ PlayerMapEmpty() {
	<div id="player-map-view">
		<p class="muted">Waiting for the DM to select a map...</p>
	</div>
}

templ PlayerMapImage(m *store.Map) {
	<div id="player-map-view" class="canvas-container" data-map-id={ m.ID }>
		<div class="canvas-wrap">
			<div class="zoom-wrap">
				<img src={ fmt.Sprintf("/maps/%s/image", m.ID) } alt={ m.Title } class="map-image"/>
			</div>
		</div>
		<script>
			(function() {
				var container = document.getElementById('player-map-view');
				var ctrl = DungeonRevealer.initPlayerCanvas(container, container.dataset.mapId);
				document.body.addEventListener('sse:fogUpdate', function() {
					if (ctrl) ctrl.refresh();
				});
				document.body.addEventListener('sse:wallUpdate', function() {
					if (ctrl) ctrl.refreshWalls();
				});
				document.body.addEventListener('sse:mapSettingsUpdate', function() {
					if (ctrl) ctrl.refreshSettings();
				});
			})();
		</script>
	</div>
}
